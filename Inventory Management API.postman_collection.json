    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {\r\n  const body = pm.response.json();\r\n\r\n  pm.collectionVariables.set(\r\n    'accessToken',\r\n    body.data.accessToken\r\n  );\r\n} else {\r\n  pm.collectionVariables.unset('accessToken');\r\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"uji.inventory@example.com\",\r\n  \"password\": \"Belajar123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {\r\n  const body = pm.response.json();\r\n\r\n  pm.collectionVariables.set(\r\n    'itemId',\r\n    String(body.data.id)\r\n  );\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Keyboard\",\r\n  \"description\": \"Keyboard mekanik\",\r\n  \"stock\": 10,\r\n  \"price\": \"150000.00\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        }
      },
      "response": []
    },
