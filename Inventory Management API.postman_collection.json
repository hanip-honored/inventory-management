      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Keyboard\",\r\n  \"description\": \"Keyboard mekanik wireless\",\r\n  \"stock\": 8,\r\n  \"price\": \"175000.00\"\r\n}",
          "options": {
